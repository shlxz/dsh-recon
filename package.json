{
  "name": "dsh-recon",
  "version": "0.4.0",
  "description": "侦察已有痕迹，把提问留到最后 — an information-acquisition routing layer for DeepSeek Harness",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "author": "shlxz",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "recon", "routing", "clarify"],
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shlxz/dsh-recon.git"
  },
  "homepage": "https://github.com/shlxz/dsh-recon#readme",
  "bugs": {
    "url": "https://github.com/shlxz/dsh-recon/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "scripts": {
